<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#2196F3</item>
        <item name="android:colorPrimary">#0F1115</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>

    <!-- Finestre di dialogo scure, arrotondate, con accento blu -->
    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#2196F3</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#ECEFF1</item>
        <item name="android:textColorSecondary">#9AA0A6</item>
    </style>
</resources>
